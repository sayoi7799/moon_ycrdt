// Checks the lib0 encoder/decoder against byte vectors produced by the
// official lib0 (see lib0_gen_test.mbt, generated by scripts/gen_fixtures.mjs).

///|
fn encoded(f : (@lib0.Encoder) -> Unit) -> String {
  let e = @lib0.Encoder::new()
  f(e)
  hex(e.to_bytes())
}

///|
fn hex(b : Bytes) -> String {
  @lib0.to_hex(b)
}

///|
fn from_hex(s : String) -> Bytes {
  @lib0.from_hex(s) catch {
    e => abort(e.to_string())
  }
}

///|
test "varUint matches lib0" {
  for c in var_uint_cases {
    let (n, h) = c
    assert_eq(encoded(e => e.write_var_uint64(n)), h)
    let d = @lib0.Decoder::new(from_hex(h))
    assert_eq(d.read_var_uint64(), n)
    assert_eq(d.has_content(), false)
  }
}

///|
test "varInt matches lib0 (sign bit at 0x40, not zigzag)" {
  for c in var_int_cases {
    let (n, h) = c
    assert_eq(encoded(e => e.write_var_int(n)), h)
    let d = @lib0.Decoder::new(from_hex(h))
    assert_eq(d.read_var_int(), n)
    assert_eq(d.has_content(), false)
  }
}

///|
test "varString matches lib0" {
  for c in var_string_cases {
    let (s, h) = c
    assert_eq(encoded(e => e.write_var_string(s)), h)
    let d = @lib0.Decoder::new(from_hex(h))
    assert_eq(d.read_var_string(), s)
    assert_eq(d.has_content(), false)
  }
}

///|
test "lone surrogate is encoded as U+FFFD like TextEncoder" {
  let (units, h) = lone_surrogate_case
  // Build the string from raw UTF-16 code units.
  let sb = StringBuilder()
  for u in units {
    sb.write_char(u.unsafe_to_char())
  }
  assert_eq(encoded(e => e.write_var_string(sb.to_string())), h)
}

///|
test "varUint8Array matches lib0" {
  for c in var_bytes_cases {
    let (arr, h) = c
    let b = Bytes::from_array(arr.map(x => x.to_byte()))
    assert_eq(encoded(e => e.write_var_bytes(b)), h)
    let d = @lib0.Decoder::new(from_hex(h))
    assert_eq(d.read_var_bytes(), b)
  }
}

///|
/// Number equality that treats NaN == NaN and distinguishes -0 from +0.
fn same_any(a : @lib0.Any, b : @lib0.Any) -> Bool {
  match (a, b) {
    (Number(x), Number(y)) =>
      x.reinterpret_as_uint64() == y.reinterpret_as_uint64()
    (Array(xs), Array(ys)) =>
      xs.length() == ys.length() &&
      xs.iter().zip(ys.iter()).all(p => same_any(p.0, p.1))
    (Object(xs), Object(ys)) =>
      xs.length() == ys.length() &&
      xs
      .iter()
      .zip(ys.iter())
      .all(p => p.0.0 == p.1.0 && same_any(p.0.1, p.1.1))
    _ => a == b
  }
}

///|
test "Any matches lib0 (integer / float32 / float64 / bigint selection)" {
  for c in any_cases {
    let (v, h) = c
    assert_eq(hex(@lib0.encode_any(v)), h)
    let back = @lib0.decode_any(from_hex(h))
    assert_true(same_any(back, v), msg="decoded \{h}")
  }
}

///|
fn expect_error(
  f : () -> Unit raise @lib0.DecodeError,
  expected : @lib0.DecodeError,
) -> Unit raise {
  try f() catch {
    e => assert_eq(e, expected)
  } noraise {
    _ => fail("expected \{expected}")
  }
}

///|
test "decoder errors" {
  expect_error(
    () => @lib0.Decoder::new(b"\x80").read_var_uint64() |> ignore,
    UnexpectedEnd,
  )
  expect_error(() => @lib0.decode_any(b"\x10") |> ignore, UnknownAnyTag(16))
  expect_error(() => @lib0.decode_any(b"\x7e\x00") |> ignore, TrailingBytes)
  expect_error(
    () => @lib0.Decoder::new(b"\x02\xff\xfe").read_var_string() |> ignore,
    InvalidUtf8,
  )
  // More than 53 bits of payload is rejected like lib0 does.
  expect_error(
    () => {
      @lib0.Decoder::new(b"\xff\xff\xff\xff\xff\xff\xff\xff\x01").read_var_uint64()
      |> ignore
    },
    IntegerOutOfRange,
  )
}
