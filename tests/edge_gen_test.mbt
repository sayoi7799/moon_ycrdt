///|
fn edge_case_55() -> ScriptCase {
  {
    name: "two replicas split the same surrogate pair",
    clients: [1U, 2U],
    ops: [
      Ins(
        0,
        0,
        "x\u{1f600}y",
        ["01010100040101740678f09f98807900"],
        "x\u{1f600}y",
        "",
      ),
      Sync(0, 1, [0], "x\u{1f600}y", ""),
      Ins(0, 2, "A", ["01010104c401010102014100"], "x\u{fffd}A\u{fffd}y", ""),
      Ins(1, 2, "B", ["01010200c401010102014200"], "x\u{fffd}B\u{fffd}y", ""),
      Del(1, 1, 1, ["000101010101"], "xB\u{fffd}y", ""),
      Sync(1, 0, [0, 1], "xAB\u{fffd}y", ""),
      Sync(0, 1, [0, 1], "xAB\u{fffd}y", ""),
      Del(0, 0, 1, ["000101010001"], "AB\u{fffd}y", ""),
      Ins(
        1,
        0,
        "\u{1f44d}",
        ["0101020144010004f09f918d00"],
        "\u{1f44d}xAB\u{fffd}y",
        "",
      ),
      Sync(1, 0, [0, 1, 2], "\u{1f44d}AB\u{fffd}y", ""),
      Sync(0, 1, [0, 1, 2], "\u{1f44d}AB\u{fffd}y", ""),
    ],
    final_text: "\u{1f44d}AB\u{fffd}y",
    final_map: "",
  }
}

