// Decoding / encoding of Yjs v1 updates against updates produced by Yjs
// (update_cases in updates_gen_test.mbt, generated by scripts/gen_fixtures.mjs).

///|
fn from_hex(s : String) -> Bytes {
  @lib0.from_hex(s) catch {
    e => abort(e.to_string())
  }
}

///|
fn id_str(id : @update.ID?) -> String {
  match id {
    Some(id) => id.to_string()
    None => "-"
  }
}

///|
/// Same format as `describeStruct` in scripts/gen_fixtures.mjs.
fn describe(s : @update.StructRef) -> String {
  match s {
    GC(id, len) => "GC \{id} len=\{len}"
    Skip(id, len) => "Skip \{id} len=\{len}"
    Item(item) => {
      let parent = match item.parent {
        Some(Root(name)) => "root:\{name}"
        Some(Item(id)) => "item:\{id}"
        None => "-"
      }
      let ps = item.parent_sub.unwrap_or("-")
      "Item \{item.id} len=\{item.content.length()} o=\{id_str(item.origin)} ro=\{id_str(item.right_origin)} p=\{parent} ps=\{ps} ref=\{item.content.ref_number()}"
    }
  }
}

///|
/// Same format as `describeDs` in scripts/gen_fixtures.mjs.
fn describe_ds(ds : @update.DeleteSet) -> String {
  let parts = []
  for client, ranges in ds.clients {
    let sb = StringBuilder()
    sb.write_string("\{client}:")
    for r in ranges {
      sb.write_string("[\{r.clock},\{r.len}]")
    }
    parts.push(sb.to_string())
  }
  parts.join(" ")
}

///|
test "decoded structs match Yjs decodeUpdate" {
  for c in update_cases {
    let (name, update_hex, _, expected_structs, expected_ds) = c
    let update = @update.decode_update(from_hex(update_hex))
    let structs = []
    for cs in update.clients {
      for s in cs.structs {
        structs.push(describe(s))
      }
    }
    assert_eq(structs, expected_structs, msg=name)
    assert_eq(describe_ds(update.delete_set), expected_ds, msg=name)
  }
}

///|
test "decode then encode reproduces the Yjs bytes exactly" {
  for c in update_cases {
    let (name, update_hex, _, _, _) = c
    let update = @update.decode_update(from_hex(update_hex))
    assert_eq(@lib0.to_hex(update.encode()), update_hex, msg=name)
  }
}

///|
test "state vector from update matches Y.encodeStateVectorFromUpdate" {
  for c in update_cases {
    let (name, update_hex, sv_hex, _, _) = c
    let update = @update.decode_update(from_hex(update_hex))
    let sv = update.state_vector()
    assert_eq(@lib0.to_hex(@update.encode_state_vector(sv)), sv_hex, msg=name)
    assert_eq(
      @update.decode_state_vector(from_hex(sv_hex)),
      sv,
      msg="\{name} (decode)",
    )
  }
}

///|
test "info byte layout" {
  // Item 1:1 "bc" with origin 1:0: bytes taken from the text_basic_gc fixture.
  let s = @update.StructRef::Item({
    id: @update.ID::new(1, 1),
    origin: Some(@update.ID::new(1, 0)),
    right_origin: None,
    parent: None,
    has_parent_sub: false,
    parent_sub: None,
    content: String("bc"),
  })
  let e = @lib0.Encoder::new()
  s.write(e, 0)
  assert_eq(@lib0.to_hex(e.to_bytes()), "840100026263")
}

///|
test "splitting a string inside a surrogate pair yields U+FFFD on both sides" {
  let (l, r) = @update.Content::String("a😀b").split(2)
  assert_eq(l, String("a\u{FFFD}"))
  assert_eq(r, String("\u{FFFD}b"))
  let (l2, r2) = @update.Content::String("abc").split(1)
  assert_eq(l2, String("a"))
  assert_eq(r2, String("bc"))
  let (l3, r3) = @update.Content::Any([Null, Bool(true), @lib0.Any::int(1)]).split(
    1,
  )
  assert_eq(l3.length(), 1)
  assert_eq(r3.length(), 2)
}

///|
test "delete set sort and merge" {
  let ds = @update.DeleteSet::new()
  ds.add(5, 10, 2)
  ds.add(5, 0, 3)
  ds.add(5, 3, 1)
  ds.add(5, 11, 4)
  ds.add(2, 7, 1)
  ds.sort_and_merge()
  assert_eq(describe_ds(ds), "5:[0,4][10,5] 2:[7,1]")
  assert_true(ds.contains(@update.ID::new(5, 14)))
  assert_true(!ds.contains(@update.ID::new(5, 15)))
}

///|
test "malformed input is rejected" {
  let r = try @update.decode_update(from_hex("010101000b")) catch {
    e => Some(e)
  } noraise {
    _ => None
  }
  assert_true(r is Some(_))
}
